!!ARBvp1.0
OPTION NV_vertex_program3;
# q3_vp.vpa -- vertex program, NV40 assembly (cgcomp -v -a), written by hand
# (no Cg compiler on Linux). Same as q3_vp.vcg plus fog:
#   result.texcoord[2].xyz = fogColor, .w = fog factor (1 = no fog).
#   d = clip w = eye-space distance along the view axis (-z_eye)
#   linear = d * fogParams.x + fogParams.y   (-1/(end-start), end/(end-start))
#   exp    = 2^(d * fogParams.z)             (-density * log2(e))
#   factor = exp + fogParams.w * (linear - exp)   (w = 1 linear, 0 exp)
# Fog off: fogParams = (0, 1, 0, 1) -> factor 1. The fragment programs
# clamp the factor (the linear term is interpolated unclamped: exact).
#var float4 position : $vin.ATTR0 : ATTR0 : 0 : 1
#var float4 color : $vin.ATTR3 : ATTR3 : 1 : 1
#var float2 tc0 : $vin.ATTR8 : ATTR8 : 2 : 1
#var float2 tc1 : $vin.ATTR9 : ATTR9 : 3 : 1
#var float4x4 mvp :  : c[0], 4 : 4 : 1
#var float4 fogParams :  : c[4], 1 : 5 : 1
#var float4 fogColor :  : c[5], 1 : 6 : 1
PARAM c[6] = { program.local[0..5] };
TEMP R0;
MOV result.color, vertex.attrib[3];
MOV result.texcoord[0].xy, vertex.attrib[8];
MOV result.texcoord[1].xy, vertex.attrib[9];
DP4 R0.x, vertex.attrib[0], c[3];
MOV result.position.w, R0.x;
DP4 result.position.z, vertex.attrib[0], c[2];
DP4 result.position.y, vertex.attrib[0], c[1];
DP4 result.position.x, vertex.attrib[0], c[0];
MAD R0.y, R0.x, c[4].x, c[4].y;
MUL R0.z, R0.x, c[4].z;
EX2 R0.z, R0.z;
ADD R0.y, R0.y, -R0.z;
MAD result.texcoord[2].w, R0.y, c[4].w, R0.z;
MOV result.texcoord[2].xyz, c[5];
END
